{
  "name": "mail-right",
  "version": "1.0.0",
  "description": "Simple web interface to check and adapt mail content with AI check",
  "main": "dist/server.js",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "dotenv -e .env -- tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "dotenv -e .env -- node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "dotenv -e .env -- tsx prisma/seed.ts",
    "pretest": "dotenv -e .env.test -- prisma db push --skip-generate",
    "test": "cross-env NODE_ENV=test TS_NODE_PROJECT=tsconfig.test.json dotenv -e .env.test -- mocha",
    "test:watch": "cross-env NODE_ENV=test TS_NODE_PROJECT=tsconfig.test.json dotenv -e .env.test -- mocha --watch",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/static": "^10.1.4",
    "@prisma/client": "^5.19.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "pino-pretty": "^11.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/chai": "^4.3.19",
    "@types/jsdom": "^21.1.7",
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.15",
    "@types/sinon": "^17.0.3",
    "@types/supertest": "^6.0.2",
    "chai": "^4.5.0",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^7.4.2",
    "jsdom": "^24.1.1",
    "mocha": "^12.0.2",
    "prisma": "^5.19.1",
    "sinon": "^18.0.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
