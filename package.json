{
  "name": "mail-right",
  "version": "1.0.0",
  "description": "Simple web interface to check and adapt mail content with AI check",
  "main": "dist/server.js",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "dotenv run -f .env -- tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "dotenv run -f .env -- node dist/server.js",
    "test": "cross-env NODE_ENV=test mocha",
    "test:watch": "cross-env NODE_ENV=test mocha --watch",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/static": "^10.1.4",
    "dotenv": "^18.0.3",
    "fastify": "^5.12.5",
    "pino-pretty": "^13.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/chai": "^4.3.19",
    "@types/mocha": "^10.0.7",
    "@types/node": "^24.13.6",
    "@types/supertest": "^7.2.1",
    "chai": "^4.5.0",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "mocha": "^12.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
