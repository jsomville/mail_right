{
  "name": "mail-right",
  "version": "1.0.0",
  "description": "Simple web interface to check and adapt mail content with AI check",
  "main": "dist/server.js",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "dotenv run -f .env -- tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "dotenv run -f .env -- node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "dotenv run -f .env -- tsx prisma/seed.ts",
    "pretest": "dotenv run -f .env.test -- prisma db push --skip-generate",
    "test": "cross-env NODE_ENV=test TS_NODE_PROJECT=tsconfig.test.json dotenv run -f .env.test -- mocha",
    "test:watch": "cross-env NODE_ENV=test TS_NODE_PROJECT=tsconfig.test.json dotenv run -f .env.test -- mocha --watch",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/static": "^10.1.4",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.3",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "pino-pretty": "^13.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/chai": "^4.3.19",
    "@types/jsdom": "^30.0.0",
    "@types/mocha": "^10.0.7",
    "@types/node": "^24.13.6",
    "@types/sinon": "^17.0.3",
    "@types/supertest": "^7.2.1",
    "chai": "^4.5.0",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "jsdom": "^30.1.1",
    "mocha": "^12.0.2",
    "prisma": "^6.19.3",
    "sinon": "^18.0.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "esbuild@0.28.2": true,
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
