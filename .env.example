# Server
PORT=3000
NODE_ENV=development

# Database (Prisma). Example for SQLite (zero-infra) or swap for postgresql://...
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="1h"

# Maximum number of past check operations kept per user (oldest are pruned)
MAX_MAIL_HISTORY=20
